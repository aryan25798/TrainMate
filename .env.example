# ==============================================================================
# TrainMate - Environment Variables Configuration Template (.env.example)
# Copy this file to .env or use these variables in Render / Cloud dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default Local Offline MySQL:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trainmate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&rewriteBatchedStatements=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

# Example Cloud MySQL (e.g. Aiven / AWS RDS / CleverCloud):
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-trainmate-xxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED&rewriteBatchedStatements=true
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your_cloud_db_password_here

# ------------------------------------------------------------------------------
# 2. SERVER & PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Local development backend runs on 8081 (production cloud uses Render $PORT)
PORT=8081

# Allowed Frontend Origins for CORS:
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:8081,https://*.vercel.app,https://*.onrender.com

# ------------------------------------------------------------------------------
# 3. DATABASE MIGRATIONS (FLYWAY)
# ------------------------------------------------------------------------------
# Set to true so Spring Boot automatically builds tables and seeds demo data on boot
SPRING_FLYWAY_ENABLED=true
