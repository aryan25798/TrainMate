# =====================================================
# LOCAL DEVELOPMENT SECRETS TEMPLATE
# Copy this file to: application-local.properties
# Fill in your actual values — that file is git-ignored
# =====================================================

spring.datasource.url=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&requireSSL=true&sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=<username>
spring.datasource.password=<password>

spring.flyway.default-schema=<dbname>
